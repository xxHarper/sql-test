            {
              "criterio": "Rangos y función",
              "puntos": 6,
              "descripcion": "Usa SUMAR.SI/SUMAR.SI.CONJUNTO/SUMIF equivalente con rango de sumas G2:G13."
            },
            {
              "criterio": "Condición",
              "puntos": 2,
              "descripcion": "Filtra únicamente EstadoPago igual a Pagado."
            },
            {
              "criterio": "Resultado correcto",
              "puntos": 2,
              "descripcion": "Obtiene 7250 con el dataset proporcionado."
            }
          ]
        }
      },
      "configuracion_respuesta": {
        "multilinea": true,
        "permite_codigo": true
      },
      "contexto_tabla": {
