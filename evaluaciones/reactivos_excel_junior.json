        "rango": "C1:H13",
        "origen": "datos_apoyo.hojas"
      }
    },
    {
      "id": "EXCEL-JR-V1-P09",
      "numero": 9,
      "tipo": "respuesta_abierta",
      "tema": "Búsqueda de datos",
      "puntaje": 10,
      "enunciado": "En «Ventas», escribe una fórmula en K2 que busque ProductoID (D2) en «Productos» y devuelva su nombre. La búsqueda debe ser exacta y permitir copiar hacia abajo hasta K13.",
      "correccion": {
