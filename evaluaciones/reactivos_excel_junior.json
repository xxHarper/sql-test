  "preguntas": [
    {
      "id": "EXCEL-JR-V1-P01",
      "numero": 1,
      "tipo": "opcion_multiple",
      "tema": "Fórmulas básicas",
      "puntaje": 4,
      "enunciado": "¿Qué fórmula suma correctamente los números de las celdas A2 a A10?",
      "opciones": [
        {
          "id": "A",
          "texto": "SUMA(A2:A10)"
        },
        {
          "id": "B",
          "texto": "=SUMA(A2:A10)"
        },
        {
          "id": "C",
          "texto": "=TOTAL(A2:A10)"
        },
        {
          "id": "D",
          "texto": "=A2:A10"
        }
      ],
      "correccion": {
        "modo": "automatica",
        "respuesta_correcta": "B",
        "justificacion_admin": "Las fórmulas comienzan por = y SUMA permite sumar rangos."
      }
    },
    {
      "id": "EXCEL-JR-V1-P02",
      "numero": 2,
      "tipo": "opcion_multiple",
      "tema": "Referencias absolutas",
      "puntaje": 4,
      "enunciado": "Quieres copiar una fórmula sin que cambie la referencia a la celda B1. ¿Cuál debes utilizar?",
      "opciones": [
        {
          "id": "A",
          "texto": "B1"
        },
        {
          "id": "B",
          "texto": "B$1"
        },
        {
          "id": "C",
          "texto": "$B1"
        },
        {
          "id": "D",
          "texto": "$B$1"
        }
      ],
      "correccion": {
        "modo": "automatica",
        "respuesta_correcta": "D",
        "justificacion_admin": "$B$1 fija columna y fila."
      }
    },
    {
      "id": "EXCEL-JR-V1-P03",
      "numero": 3,
      "tipo": "opcion_multiple",
      "tema": "Filtros",
      "puntaje": 4,
      "enunciado": "Tienes una tabla y quieres mostrar únicamente las filas cuyo EstadoPago sea «Pagado» sin borrar las demás. ¿Qué herramienta usarías?",
      "opciones": [
        {
          "id": "A",
          "texto": "Datos > Filtro"
        },
        {
          "id": "B",
          "texto": "Reemplazar todo"
        },
        {
          "id": "C",
          "texto": "Combinar celdas"
        },
        {
          "id": "D",
          "texto": "Eliminar duplicados"
        }
      ],
      "correccion": {
        "modo": "automatica",
        "respuesta_correcta": "A",
        "justificacion_admin": "Filtrar permite ocultar temporalmente las filas que no cumplen el criterio."
      }
    },
    {
      "id": "EXCEL-JR-V1-P04",
      "numero": 4,
      "tipo": "opcion_multiple",
      "tema": "CONTAR.SI",
      "puntaje": 4,
      "enunciado": "Si EstadoPago está en H2:H13, ¿qué fórmula cuenta las celdas que contienen exactamente «Pagado»?",
      "opciones": [
        {
          "id": "A",
          "texto": "=CONTAR(H2:H13;\"Pagado\")"
        },
        {
          "id": "B",
          "texto": "=SUMA(H2:H13;\"Pagado\")"
        },
        {
          "id": "C",
          "texto": "=CONTAR.SI(H2:H13;\"Pagado\")"
        },
        {
          "id": "D",
          "texto": "=PROMEDIO.SI(H2:H13;\"Pagado\")"
        }
      ],
      "correccion": {
        "modo": "automatica",
        "respuesta_correcta": "C",
        "justificacion_admin": "CONTAR.SI cuenta coincidencias con un criterio."
      }
    },
    {
      "id": "EXCEL-JR-V1-P05",
      "numero": 5,
      "tipo": "opcion_multiple",
      "tema": "Macros y seguridad",
      "puntaje": 4,
      "enunciado": "¿Cuál afirmación describe mejor a los archivos y macros de Excel?",
      "opciones": [
        {
          "id": "A",
          "texto": "Un archivo .xlsm puede contener macros VBA; solo deben habilitarse macros confiables."
        },
        {
          "id": "B",
          "texto": "Un archivo .xlsx siempre conserva macros VBA al guardarse."
        },
        {
          "id": "C",
          "texto": "Las macros siempre son seguras si el archivo llegó por correo."
        },
        {
          "id": "D",
          "texto": "Una macro es únicamente un formato visual, no puede automatizar tareas."
        }
      ],
      "correccion": {
        "modo": "automatica",
        "respuesta_correcta": "A",
        "justificacion_admin": "El formato habilitado para macros es .xlsm; no deben activarse macros desconocidas."
      }
    },
    {
      "id": "EXCEL-JR-V1-P06",
      "numero": 6,
      "tipo": "respuesta_abierta",
      "tema": "Operaciones básicas",
      "puntaje": 10,
      "enunciado": "En la hoja «Ventas», escribe la fórmula que debe colocarse en G2 (columna Importe) para calcular Cantidad × PrecioUnitario. Explica cómo aplicarla hasta G13.",
      "correccion": {
        "modo": "manual",
        "respuesta_referencia": "En G2: =E2*F2. Luego copiar o arrastrar el controlador de relleno hasta G13. En V-001 da 900.",
        "rubrica": {
          "criterios": [
            {
              "criterio": "Fórmula válida en G2",
              "puntos": 6,
              "descripcion": "Multiplica correctamente E2 por F2, con referencias relativas."
            },
            {
              "criterio": "Aplicación a las demás filas",
              "puntos": 4,
              "descripcion": "Describe copiar/arrastrar hasta G13 sin valores fijos."
            }
          ]
        }
      },
      "configuracion_respuesta": {
        "multilinea": true,
        "permite_codigo": true
      },
      "contexto_tabla": {
        "hoja": "Ventas",
        "rango": "D1:G13",
        "origen": "datos_apoyo.hojas"
      }
    },
    {
      "id": "EXCEL-JR-V1-P07",
      "numero": 7,
      "tipo": "respuesta_abierta",
      "tema": "Función SI",
      "puntaje": 10,
      "enunciado": "En «Ventas», escribe la fórmula para J2 (Clasificación): si H2 es «Pagado» debe aparecer «Cobrado»; en cualquier otro caso, «No cobrado». Explica cómo copiarla hasta J13.",
      "correccion": {
        "modo": "manual",
        "respuesta_referencia": "En J2: =SI(H2=\"Pagado\";\"Cobrado\";\"No cobrado\") o =IF(H2=\"Pagado\",\"Cobrado\",\"No cobrado\"). Copiar hasta J13.",
        "rubrica": {
          "criterios": [
            {
              "criterio": "Condición y sintaxis de SI",
              "puntos": 6,
              "descripcion": "Distingue exactamente Pagado y devuelve Cobrado."
            },
            {
              "criterio": "Valor alternativo",
              "puntos": 2,
              "descripcion": "Devuelve No cobrado en los demás casos."
            },
            {
              "criterio": "Copiado correcto",
              "puntos": 2,
              "descripcion": "Indica cómo replicar hasta J13."
            }
          ]
        }
      },
      "configuracion_respuesta": {
        "multilinea": true,
        "permite_codigo": true
      },
      "contexto_tabla": {
        "hoja": "Ventas",
        "rango": "H1:J13",
        "origen": "datos_apoyo.hojas"
      }
    },
    {
      "id": "EXCEL-JR-V1-P08",
      "numero": 8,
      "tipo": "respuesta_abierta",
      "tema": "SUMAR.SI",
      "puntaje": 10,
      "enunciado": "Tras llenar Importe (G2:G13), escribe una fórmula en «Resumen»!B2 que sume solamente el Importe de las ventas cuyo EstadoPago sea «Pagado». Incluye el resultado numérico esperado.",
      "correccion": {
        "modo": "manual",
        "respuesta_referencia": "En Resumen!B2: =SUMAR.SI(Ventas!H2:H13;\"Pagado\";Ventas!G2:G13). También se acepta SUMAR.SI.CONJUNTO equivalente o SUMIF en inglés. Resultado: $7,250.",
        "rubrica": {
